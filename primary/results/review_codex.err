     8	def stats(d):
     9	    c, D = d.c.values.astype(float), d.D.values; w = 1 / c; w = w / w.sum()   # population weights (inclusion ~ c)
    10	    Ec, Ec2 = (w * c).sum(), (w * c * c).sum()
    11	    fit = LogisticRegression(C=1e6).fit(np.log(c)[:, None], D)                # unweighted: selection is on c only
    12	    q = fit.predict_proba(np.log(c)[:, None])[:, 1]
    13	    return dict(d=(w * D).sum(), beta=fit.coef_[0, 0], B_head=(w * D * c).sum() / (w * D).sum() / Ec,
    14	                B=(w * c * c * q).sum() / ((w * c * q).sum() * Ec), B0=Ec2 / Ec**2, B_emp=(w * c * c * D).sum() / ((w * c * D).sum() * Ec))
    15	est = stats(df); rng = np.random.default_rng(0)
    16	boot = pd.DataFrame([stats(df.sample(len(df), replace=True, random_state=rng.integers(1e9))) for _ in range(1000)])
    17	est["B_over_B0"] = est["B"] / est["B0"]; boot["B_over_B0"] = boot["B"] / boot["B0"]
