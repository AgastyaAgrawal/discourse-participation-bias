import json,csv,collections,math,statistics,os
from datetime import datetime,timezone
S=json.load(open('\\''primary/data/final_sample.json'\\'')); order=json.load(open('\\''primary/data/blind_order.json'\\''))
L='\\'''\\''.join(open('\\''primary/data/final_labels.txt'\\'').read().split()); R='\\''1000101011100110101011111110011101001111'\\''
U=list(csv.DictReader(open('\\''primary/results/final_users.csv'\\'')))
print('\\''Sample size, users, ids:'\\'',len(S),len({s['\\''author'\\''] for s in S}),len({s['\\''id'\\''] for s in S}))
print('\\''labels lengths, order valid:'\\'',len(L),len(R),sorted(order)==list(range(len(S))))
print('\\''sample CSV matching:'\\'',all(str(s['\\''id'\\''])==u['\\''id'\\''] and str(s['\\''c'\\''])==u['\\''c'\\''] and int(L[order.index(i)])==int(u['\\''D'\\'']) for i,(s,u) in enumerate(zip(S,U))))
cs=[s['\\''c'\\''] for s in S]; ds=[int(u['\\''D'\\'']) for u in U]
print('\\''c summary:'\\'',min(cs),statistics.median(cs),max(cs),'\\''sum'\\'',sum(cs),'\\''raw rate'\\'',sum(ds)/len(ds))
conf=collections.Counter((int(a),int(b)) for a,b in zip(R,L[:40])); po=sum(a==b for a,b in zip(R,L))/40; pr=sum(map(int,R))/40; pl=sum(map(int,L[:40]))/40; pe=pr*pl+(1-pr)*(1-pl)
print('\\''confusion (reviewer,original)'\\'',dict(conf),'\\''agreement'\\'',po,'\\''kappa'\\'',(po-pe)/(1-pe),'\\''positive rates'\\'',pr,pl)
for k,(a,b) in enumerate(zip(R,L[:40])):
 if a"'!=b: print('"'\\''disagreement'\\'',k,'\\''sample index'\\'',order[k],'\\''c'\\'',S[order[k]]['\\''c'\\''],'\\''top_level'\\'',S[order[k]]['\\''top_level'\\''],'\\''reviewer'\\'',a,'\\''original'\\'',b)
print('\\''top-level N, D'\\'',sum(s['\\''top_level'\\''] for s in S),sum(d for s,d in zip(S,ds) if s['\\''top_level'\\'']))
w=[1/c for c in cs]; W=sum(w); Ec=sum(c*v for c,v in zip(cs,w))/W
print('\\''direct d B_head B0 B_emp:'\\'',sum(v*d for v,d in zip(w,ds))/W,sum(ds)/sum(v*d for v,d in zip(w,ds))/Ec,(sum(cs)/W)/(Ec**2),sum(c*d for c,d in zip(cs,ds))/sum(ds)/Ec)
# Read-only first-order score/Hessian sensitivity at the reported beta.
beta=float(next(r for r in csv.DictReader(open('\\''primary/results/final_estimates.csv'\\'')) if r['\\'''\\'']=='\\''beta'\\'')['\\''estimate'\\'']); x=[math.log(c) for c in cs]
def sig(t): return 1/(1+math.exp(-t))
lo,hi=-30,30
for _ in range(100):
 a=(lo+hi)/2
 if sum(sig(a+beta*v) for v in x)>sum(ds): hi=a
 else: lo=a
q=[sig(a+beta*v) for v in x]; v=[z*(1-z) for z in q]; h00=sum(v);h01=sum(t*z for t,z in zip(v,x));h11=sum(t*z*z for t,z in zip(v,x))
delta0=sum(int(a)-int(b) for a,b in zip(R,L[:40])); delta1=sum((int(a)-int(b))*x[order[k]] for k,(a,b) in enumerate(zip(R,L[:40])))
dbeta=(h00*delta1-h01*delta0)/(h00*h11-h01*h01)
print('\\''beta original, first-order label-change delta, approximate beta:'\\'',beta,dbeta,beta+dbeta)
print('\\''weights effective N'\\'',(sum(w)**2)/sum(t*t for t in w),'\\''largest weight share'\\'',max(w)/sum(w))
print('\\''highest counts'\\'',sorted(cs)[-10:])
for p in ['\\''primary/results/LOG.md'\\'','\\''primary/src/fetch_final.py'\\'','\\''primary/src/print_blind.py'\\'','\\''primary/src/rubric.md'\\'','\\''primary/src/analyze_final.py'\\'','\\''primary/data/blind_print.txt'\\'','\\''primary/data/final_labels.txt'\\'','\\''primary/results/final_estimates.csv'\\'']:
 st=os.stat(p);print('\\''mtime'\\'',p,datetime.fromtimestamp(st.st_mtime,timezone.utc).isoformat())
