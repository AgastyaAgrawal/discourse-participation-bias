    25	fit = LogisticRegression(C=1e6).fit(np.log(df.c.values)[:, None], df.D); xs = np.logspace(0, np.log10(df.c.max()), 100)
    26	fig, ax = plt.subplots(1, 2, figsize=(11, 4))
    27	ax[0].errorbar(x, m, yerr=1.96 * se, fmt="o", label="binned rate (95% CI)"); ax[0].plot(xs, fit.predict_proba(np.log(xs)[:, None])[:, 1], label=f"logistic fit, β={est['beta']:.2f}")
